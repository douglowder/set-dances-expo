@@ -0,0 +1,48 @@
+// Copyright 2022-present 650 Industries. All rights reserved.
+
+import Foundation
+
+/**
+ Error codes for expo-updates logs
+ */
+public enum UpdatesErrorCode: Int, Sendable {
+  case none = 0
+  case noUpdatesAvailable = 1
+  case updateAssetsNotAvailable = 2
+  case updateServerUnreachable = 3
+  case updateHasInvalidSignature = 4
+  case updateFailedToLoad = 5
+  case assetsFailedToLoad = 6
+  case jsRuntimeError = 7
+  case unknown = 8
+  case updateCodeSigningError = 9
+  case initializationError = 10
+
+  /// The `code` string of a log entry, the same as `UpdatesErrorCode.code` on Android.
+  public var asString: String {
+    switch self {
+    case .none:
+      return "None"
+    case .noUpdatesAvailable:
+      return "NoUpdatesAvailable"
+    case .updateAssetsNotAvailable:
+      return "UpdateAssetsNotAvailable"
+    case .updateServerUnreachable:
+      return "UpdateServerUnreachable"
+    case .updateHasInvalidSignature:
+      return "UpdateHasInvalidSignature"
+    case .updateCodeSigningError:
+      return "UpdateCodeSigningError"
+    case .updateFailedToLoad:
+      return "UpdateFailedToLoad"
+    case .assetsFailedToLoad:
+      return "AssetsFailedToLoad"
+    case .jsRuntimeError:
+      return "JSRuntimeError"
+    case .initializationError:
+      return "InitializationError"
+    case .unknown:
+      return "Unknown"
+    }
+  }
+}
diff --git a/ios/EXUpdatesInterface/UpdatesLogEntryListenerRegistry.swift b/ios/EXUpdatesInterface/UpdatesLogEntryListenerRegistry.swift
new file mode 100644
index 0000000000000000000000000000000000000000..a9700a0b230bd89f037e99f44708a88497a64ffc
--- /dev/null
+++ b/ios/EXUpdatesInterface/UpdatesLogEntryListenerRegistry.swift
@@ -0,0 +1,41 @@
+//  Copyright © 2026-present 650 Industries. All rights reserved.
+
+import Foundation
+
+/// Receives expo-updates log entries at the warning level or higher as they are logged. An entry has
+/// the same fields as the entries that `readLogEntriesAsync` returns: `timestamp`, `message`, `code`,
+/// `level`, and optionally `updateId`, `assetId`, `stacktrace`, and `duration`.
+public protocol UpdatesLogEntryListener: AnyObject {
+  /// Called on the thread that logged the entry.
+  func updatesLogEntryWasLogged(_ entry: [String: Any])
+}
+
+/// Delivers expo-updates log entries to listeners in the same process, so other modules can report
+/// them without reading the log file. It does not depend on whether updates are enabled. The
+/// registry keeps each listener alive until `remove` is called with it.
+public final class UpdatesLogEntryListenerRegistry: @unchecked Sendable {
+  public static let sharedInstance = UpdatesLogEntryListenerRegistry()
+
+  private let lock = NSLock()
+  private var listeners: [ObjectIdentifier: UpdatesLogEntryListener] = [:]
+
+  public func add(_ listener: UpdatesLogEntryListener) {
+    lock.withLock {
+      listeners[ObjectIdentifier(listener)] = listener
+    }
+  }
+
+  public func remove(_ listener: UpdatesLogEntryListener) {
+    lock.withLock {
+      listeners[ObjectIdentifier(listener)] = nil
+    }
+  }
+
+  /// Delivers the entry to each listener outside the lock, so a listener can add or remove listeners.
+  public func notify(_ entry: [String: Any]) {
+    let currentListeners = lock.withLock { Array(listeners.values) }
+    for listener in currentListeners {
+      listener.updatesLogEntryWasLogged(entry)
+    }
+  }
+}
